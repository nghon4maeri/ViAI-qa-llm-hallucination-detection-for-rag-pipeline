# infrastructure/k8s/helmfile.yaml.gotmpl
# Manages all Helm releases for the hallucination detection MLOps platform (the k8s part of the
# architecture). Two environments:
#   prod   GKE (values/*-prod.yaml)
#   local  minikube profile viai-qa: the same releases with values/<release>-local.yaml layered on top
#          (smaller resources, images built locally, no cloud services)
# Usage (from this directory):
#   helmfile -e local sync                       — deploy everything on minikube
#   helmfile -e prod  sync                       — deploy everything on GKE
#   helmfile -e local sync -l tier=infra         — infrastructure only (also tier=app, tier=observability)
#   helmfile -e local destroy                    — remove everything
# KServe and cert-manager are cluster add-ons, installed first by Ansible (setup_*_stack.yaml) or
# by `deployctl addons` (infrastructure/k8s/deployctl).

repositories:
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: grafana
    url: https://grafana.github.io/helm-charts
  - name: jaegertracing
    url: https://jaegertracing.github.io/helm-charts
  - name: jetstack
    url: https://charts.jetstack.io
  - name: ingress-nginx
    url: https://kubernetes.github.io/ingress-nginx

environments:
  prod:
    values:
      - values/platform-prod.yaml
      - values/backend-prod.yaml
      - values/model-prod.yaml
  local:
    kubeContext: viai-qa    # the minikube profile deployctl creates; never a cloud cluster

---
# helmfile v1: environments and releases live in separate YAML parts
helmDefaults:
  wait: true
  timeout: 600
  atomic: true
  cleanupOnFail: true

{{- $env := .Environment.Name }}

releases:
  - name: namespaces
    namespace: default
    chart: charts/namespaces
    labels:
      tier: infra

  - name: postgres
    namespace: hallucination-prod
    chart: charts/postgres
    labels:
      tier: infra
    missingFileHandler: Info
    values:
      - values/postgres-{{ $env }}.yaml
    needs:
      - default/namespaces

  - name: mlflow
    namespace: hallucination-prod
    chart: charts/mlflow
    labels:
      tier: infra
    missingFileHandler: Info
    values:
      - values/mlflow-{{ $env }}.yaml
    needs:
      - hallucination-prod/postgres

  - name: mlflow-runtime
    namespace: hallucination-prod
    chart: charts/mlflow-runtime
    labels:
      tier: infra
    missingFileHandler: Info
    values:
      - values/mlflow-runtime-{{ $env }}.yaml
    needs:
      - hallucination-prod/mlflow

  - name: hallucination-backend
    namespace: hallucination-prod
    chart: charts/hallucination-backend
    labels:
      tier: app
    missingFileHandler: Info
    values:
      - values/backend-prod.yaml
      - values/backend-{{ $env }}.yaml
    needs:
      - hallucination-prod/postgres
      - hallucination-prod/mlflow

  - name: hallucination-model
    namespace: hallucination-prod
    chart: charts/hallucination-model
    labels:
      tier: app
    missingFileHandler: Info
    values:
      - values/model-prod.yaml
      - values/model-{{ $env }}.yaml
    needs:
      - hallucination-prod/mlflow-runtime

  - name: nginx-gateway
    namespace: hallucination-prod
    chart: ingress-nginx/ingress-nginx
    version: "4.11.3"
    labels:
      tier: infra
    missingFileHandler: Info
    values:
      - ../nginx/ingress-nginx-values.yaml
      - values/nginx-gateway-{{ $env }}.yaml
    needs:
      - default/namespaces

  - name: monitoring-stack
    namespace: monitoring
    chart: prometheus-community/kube-prometheus-stack
    version: "55.5.0"
    labels:
      tier: observability
      component: metrics
    missingFileHandler: Info
    values:
      - ../observability/prometheus/values.yaml
      - values/monitoring-stack-{{ $env }}.yaml
    needs:
      - default/namespaces

  - name: loki-stack
    namespace: monitoring
    chart: grafana/loki-stack
    version: "2.10.2"
    labels:
      tier: observability
      component: logging
    values:
      - ../observability/loki/values.yaml
    needs:
      - default/namespaces

  - name: jaeger
    namespace: monitoring
    chart: jaegertracing/jaeger
    version: "0.71.14"
    labels:
      tier: observability
      component: tracing
    values:
      - ../observability/jaeger/values.yaml
    needs:
      - default/namespaces

  - name: grafana
    namespace: monitoring
    chart: grafana/grafana
    version: "7.0.19"
    labels:
      tier: observability
      component: dashboards
    missingFileHandler: Info
    values:
      - ../observability/grafana/values.yaml
      - values/grafana-{{ $env }}.yaml
    # the values mount configmap grafana-dashboards-cm (the dashboards JSON); Ansible creates it with the
    # same command, and without it the pod never leaves ContainerCreating
    hooks:
      - events: ["presync"]
        showlogs: true
        command: sh
        args:
          - -c
          - >-
            kubectl {{ with .Environment.KubeContext }}--context {{ . }} {{ end }}-n monitoring
            create configmap grafana-dashboards-cm --from-file=../observability/grafana/provisioning/dashboards/
            --dry-run=client -o yaml |
            kubectl {{ with .Environment.KubeContext }}--context {{ . }} {{ end }}apply -f -
    needs:
      - monitoring/monitoring-stack
      - monitoring/loki-stack
      - monitoring/jaeger

  - name: evidently-drift
    namespace: hallucination-prod
    chart: charts/evidently-drift
    labels:
      tier: observability
      component: drift
    missingFileHandler: Info
    values:
      - ../observability/evidently/values.yaml
      - values/evidently-drift-{{ $env }}.yaml
    needs:
      - monitoring/monitoring-stack
      - hallucination-prod/hallucination-backend
