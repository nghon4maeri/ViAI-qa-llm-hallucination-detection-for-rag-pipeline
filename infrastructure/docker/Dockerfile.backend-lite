# Slim ViAI-QA backend for local clusters (helmfile -e local): no torch / transformers, so the image is
# a few hundred MB instead of several GB. The detector runs as the mock engine (DISABLE_MODEL=true);
# the real model is served separately by the KServe predictor. Production uses Dockerfile.backend.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    DISABLE_MODEL=true

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# the dependency set CI tests the API with, plus the ASGI server
COPY requirements/ci.txt requirements-ci.txt
RUN pip install --no-cache-dir -r requirements-ci.txt "uvicorn[standard]>=0.29.0"

COPY machine-learning/pyproject.toml machine-learning/pyproject.toml
COPY machine-learning/vihallu_features machine-learning/vihallu_features
RUN pip install --no-cache-dir ./machine-learning

COPY applications/api/backend backend
COPY applications/api/alembic.ini alembic.ini

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD curl -f http://localhost:8080/health || exit 1
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8080"]
